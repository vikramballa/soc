# ---------------------------------------------------------------------------------------------
# SentinelX configuration. Copy to .env and fill in values. Never commit .env.
# `scripts/setup.sh` generates a working .env for local installs automatically.
# ---------------------------------------------------------------------------------------------

# development | production   (production refuses to start with weak secrets / insecure cookies)
APP_ENV=development
# 64 random hex chars:  openssl rand -hex 32
APP_SECRET=
APP_BASE_URL=http://localhost:8000
# Set to true when SentinelX is served over HTTPS (required in production)
SESSION_COOKIE_SECURE=false
LOG_JSON=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL 15+). The role must NOT be a superuser (superusers bypass row-level security).
DATABASE_URL=postgresql+asyncpg://sentinelx:CHANGE_ME@127.0.0.1:5432/sentinelx
# Docker Compose only:
POSTGRES_SUPERUSER_PASSWORD=
SENTINELX_DB_PASSWORD=

# --- First administrator (created once by `sentinelx init`; a random password is generated if empty)
BOOTSTRAP_ADMIN_EMAIL=admin@sentinelx.local
BOOTSTRAP_ADMIN_PASSWORD=

# --- Background worker: run inside the API process (simplest) or as `sentinelx worker`
EMBEDDED_WORKER=true

# --- Local AI analyst (optional; detection never depends on it). Local Ollama models only.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
AI_ENABLED=true

# --- Correlation & promotion (all optional; documented in docs/architecture/correlation.md)
CORRELATION_WINDOW_MINUTES=60
INCIDENT_PROMOTE_RISK=50
INCIDENT_PROMOTE_SEVERITY=70
EVENT_RETENTION_DAYS=30

# --- Telemetry sources (file tailing on the same host; leave empty if you push over HTTP)
SURICATA_EVE_PATH=
ZEEK_LOG_DIR=
WAZUH_ALERTS_PATH=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
# organization (tenant slug) that file/indexer ingestion writes into
FILE_INGEST_TENANT=default

# --- Threat intelligence (optional)
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true

# --- OpenSearch sink (optional, for high-volume telemetry search)
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_TLS=true

# --- Single sign-on via Keycloak (optional). AUTH_MODE: local | oidc | both
AUTH_MODE=local
KEYCLOAK_URL=
KEYCLOAK_REALM=sentinelx
KEYCLOAK_CLIENT_ID=sentinelx-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=

# --- Observability profile (Docker Compose)
GRAFANA_ADMIN_PASSWORD=
