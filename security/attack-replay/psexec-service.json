{
  "id": "psexec-service",
  "name": "PsExec service installed on a remote host",
  "techniques": [
    "T1021.002",
    "T1569.002"
  ],
  "source": "wazuh",
  "events": [
    {
      "@offset": -120,
      "rule": {
        "id": "60000",
        "level": 5,
        "description": "Windows event",
        "groups": [
          "windows",
          "windows_system"
        ]
      },
      "agent": {
        "id": "017",
        "name": "SRV-APP-02",
        "ip": "10.20.30.17"
      },
      "data": {
        "win": {
          "system": {
            "eventID": "7045",
            "channel": "System",
            "computer": "SRV-APP-02"
          },
          "eventdata": {
            "serviceName": "PSEXESVC",
            "imagePath": "%SystemRoot%\\PSEXESVC.exe",
            "serviceType": "user mode service",
            "accountName": "LocalSystem"
          }
        }
      },
      "location": "EventChannel"
    }
  ],
  "expect": [
    "PsExec-Style Service Installed"
  ],
  "log_type": null,
  "hunt": false
}
